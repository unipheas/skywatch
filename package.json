{
  "name": "skywatch",
  "private": true,
  "version": "0.1.0",
  "description": "Aircraft overhead, at a glance.",
  "author": "unipheas",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "build": "busy-cli build",
    "app:install": "busy-cli app install",
    "app:uninstall": "busy-cli app uninstall",
    "app:run": "busy-cli app run",
    "app:stop": "busy-cli app stop",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "devDependencies": {
    "@busy-app/cli": "^0.6.0",
    "typescript": "~6.0.3",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@busy-app/busy-lib": "^0.21.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unipheas/skywatch.git"
  },
  "overrides": {
    "vite": "$vite"
  }
}
